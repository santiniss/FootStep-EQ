<Window x:Class="StrikeEQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StrikeEQ.Controls"
        Title="FootStep EQ — Equalizador Gamer"
        Width="1180" Height="740"
        MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgGradient}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Crimson Glow Accent Strip -->
        <Rectangle Grid.Row="0" Fill="{StaticResource CrimsonAccentGradient}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT NAVIGATION SIDEBAR ==================== -->
            <Border Grid.Column="0" Background="{StaticResource PanelBgGradient}"
                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0"
                    Padding="16,18,16,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Brand Logo -->
                    <StackPanel Grid.Row="0" Margin="2,0,0,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="9" Margin="0,0,11,0"
                                    Background="{StaticResource CrimsonButtonGradient}" BorderBrush="#FF5C74" BorderThickness="1">
                                <TextBlock Text="EQ" FontWeight="Black" FontSize="15" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="FOOTSTEP" FontSize="16" FontWeight="Black" Foreground="#FFFFFF"/>
                                    <TextBlock Text="EQ" FontSize="16" FontWeight="Black" Foreground="{StaticResource AccentRedBrush}" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="GAMING AUDIO" FontSize="9.5" FontWeight="Bold" Foreground="#9E8A91"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Detected Game Badge -->
                        <Border x:Name="GameBadgeBorder" Background="#251018" BorderBrush="#661D30" BorderThickness="1"
                                CornerRadius="6" Padding="9,5" Margin="0,12,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="TxtActiveGame" Text="" FontSize="10.5" FontWeight="Bold"
                                       Foreground="#FF5C74" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>

                    <!-- Navigation Menu -->
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="MENU" FontSize="10" FontWeight="Bold" Foreground="#7A656C" Margin="6,0,0,8"/>

                        <RadioButton x:Name="NavEqualizer" GroupName="MainNav" IsChecked="True"
                                     Style="{StaticResource SidebarNavButton}" Checked="OnNavChanged" Tag="Equalizer">
                            <TextBlock Text="Equalizador"/>
                        </RadioButton>

                        <RadioButton x:Name="NavProfiles" GroupName="MainNav"
                                     Style="{StaticResource SidebarNavButton}" Checked="OnNavChanged" Tag="Profiles">
                            <TextBlock Text="Perfis de Jogo"/>
                        </RadioButton>

                        <RadioButton x:Name="NavSoundTest" GroupName="MainNav"
                                     Style="{StaticResource SidebarNavButton}" Checked="OnNavChanged" Tag="SoundTest">
                            <TextBlock Text="Testar Som"/>
                        </RadioButton>

                        <RadioButton x:Name="NavAudioOutput" GroupName="MainNav"
                                     Style="{StaticResource SidebarNavButton}" Checked="OnNavChanged" Tag="AudioOutput">
                            <TextBlock Text="Saída de Áudio"/>
                        </RadioButton>
                    </StackPanel>

                    <!-- Sidebar Bottom Status + Master Power -->
                    <StackPanel Grid.Row="3">
                        <!-- Clickable Headset Quick Status -->
                        <Border x:Name="SidebarAudioStatusCard" Background="{StaticResource CardBgGradient}"
                                BorderBrush="#331922" BorderThickness="1" CornerRadius="9"
                                Padding="11,9" Margin="0,0,0,10" Cursor="Hand"
                                MouseLeftButtonUp="OnSidebarAudioCardClick"
                                ToolTip="Clique para configurar sua saída de áudio">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="#7A656C"
                                             Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSidebarAudioState" Text="Fone não ativado"
                                               FontSize="11" FontWeight="Bold" Foreground="#F5F2F4"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtSidebarHeadsetName" Text="Configurar saída..."
                                           FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="15,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Master Power Button -->
                        <ToggleButton x:Name="BtnMasterPower" Height="40" Click="OnBypassClick"
                                      Cursor="Hand" ToolTip="Ligar / Desligar equalização (Atalho: Ctrl+Alt+B)">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bd" Background="{StaticResource CrimsonButtonGradient}"
                                            BorderBrush="#FF5C74" BorderThickness="1.5" CornerRadius="9">
                                        <TextBlock x:Name="txt" Text="● EQUALIZADOR LIGADO" FontWeight="Black" FontSize="11.5"
                                                   Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#1B1518"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#4A343B"/>
                                            <Setter TargetName="txt" Property="Text" Value="○ DESLIGADO"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="#9E8A91"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== MAIN PAGE VIEWPORT ==================== -->
            <Grid Grid.Column="1" Margin="22,18,22,20">

                <!-- ============================================================ -->
                <!-- PAGE 1: EQUALIZADOR (SPACIOUS & CLEAN)                       -->
                <!-- ============================================================ -->
                <Grid x:Name="PageEqualizer" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="186"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Page Header + Quick Preset Picker + Quick Boosts -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock x:Name="TxtProfileName" Text="CS2 — Precision Footsteps" FontSize="21" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock x:Name="TxtProfileDesc" Text="Destaca passos e reduz graves pesados."
                                       FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox x:Name="CmbQuickProfile" Width="210" Margin="0,0,10,0"
                                      DisplayMemberPath="Name" SelectionChanged="OnQuickProfileChanged"
                                      ToolTip="Trocar rapidamente o perfil ativo"/>
                            <Button Content="★ + Passos" Style="{StaticResource CrimsonButton}" Padding="13,7" Margin="0,0,7,0"
                                    Click="OnQuickBoostFootstepsClick" ToolTip="Sobe as frequências de passos (2k–4k Hz)"/>
                            <Button Content="− Graves" Style="{StaticResource GamerButton}" Padding="11,7" Margin="0,0,7,0"
                                    Click="OnQuickCutBassClick" ToolTip="Diminui graves e explosões (32–125 Hz)"/>
                            <Button Content="Zerar" Style="{StaticResource GamerButton}" Padding="11,7"
                                    Click="OnResetFlatClick" ToolTip="Volta todas as frequências para 0 dB"/>
                        </StackPanel>
                    </Grid>

                    <!-- Interactive Crimson EQ Curve Canvas -->
                    <Border Grid.Row="1" BorderBrush="#3C1B25" BorderThickness="1" CornerRadius="11"
                            ClipToBounds="True" Margin="0,0,0,16">
                        <controls:EqCurveCanvas x:Name="EqCanvas"/>
                    </Border>

                    <!-- 10 Wide Vertical Frequency Sliders -->
                    <UniformGrid x:Name="FaderBankGrid" Grid.Row="2" Columns="10" Margin="0,0,0,16"/>

                    <!-- Sleek Bottom Bar: Modo Passos (1 Slider) -->
                    <Border Grid.Row="3" Background="{StaticResource CardBgGradient}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="11" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton x:Name="BtnScoutMode" Grid.Column="0" Content="DESLIGADO" Width="108" Height="32"
                                          Style="{StaticResource CrimsonToggle}" Click="OnScoutModeToggled" Margin="0,0,14,0"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                <TextBlock Text="MODO PASSOS &amp; PROTEÇÃO DE TIROS" FontSize="12" FontWeight="Bold" Foreground="#FF3B57"/>
                                <TextBlock Text="Reduz tiros altos e aumenta passos distantes" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>

                            <Slider x:Name="SldFootstepIntensity" Grid.Column="2" Minimum="1" Maximum="100" Value="55"
                                    Style="{StaticResource CrimsonHorizontalSlider}" VerticalAlignment="Center"
                                    ValueChanged="OnFootstepIntensityChanged"/>

                            <TextBlock x:Name="TxtIntensityLabel" Grid.Column="3" Text="Médio" FontSize="12" FontWeight="Bold"
                                       Foreground="#FF5C74" VerticalAlignment="Center" TextAlignment="Center"/>

                            <Border Grid.Column="4" Height="10" Background="#0D090B" BorderBrush="#331921" BorderThickness="1"
                                    CornerRadius="5" VerticalAlignment="Center" ToolTip="Atividade em tempo real do Modo Passos">
                                <Border x:Name="MeterGainReduction" HorizontalAlignment="Left" Width="0" CornerRadius="4"
                                        Background="{StaticResource CrimsonAccentGradient}"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ============================================================ -->
                <!-- PAGE 2: PERFIS DE JOGO                                       -->
                <!-- ============================================================ -->
                <Grid x:Name="PageProfiles" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Perfis de Jogo" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                            <TextBlock Text="Escolha um ajuste pronto para seu jogo ou crie seus próprios perfis personalizados."
                                       FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="+ Novo Perfil" Style="{StaticResource CrimsonButton}" Padding="14,8" Margin="0,0,8,0"
                                    Click="OnCloneProfileClick"/>
                            <Button Content="Salvar Tudo" Style="{StaticResource GamerButton}" Padding="14,8"
                                    Click="OnSaveProfilesClick"/>
                        </StackPanel>
                    </DockPanel>

                    <ListBox x:Name="LstProfiles" Grid.Row="1" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnProfileSelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,12,12"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="card" Background="{StaticResource CardBgGradient}"
                                                    BorderBrush="#2E1820" BorderThickness="1"
                                                    CornerRadius="11" Padding="16,14" Cursor="Hand">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="card" Property="BorderBrush" Value="#7A2438"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="card" Property="BorderBrush" Value="#FF2442"/>
                                                    <Setter TargetName="card" Property="Background">
                                                        <Setter.Value>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#3B101C" Offset="0.0"/>
                                                                <GradientStop Color="#160C10" Offset="1.0"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <Border DockPanel.Dock="Right" Background="#2B121B" BorderBrush="#5E1D2F"
                                                BorderThickness="1" CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="#FF5C74"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Bold"
                                                   Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="#A8939A"
                                               TextWrapping="Wrap" MaxHeight="48"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" Background="{StaticResource PanelBgGradient}" BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,8,0,0">
                        <DockPanel>
                            <CheckBox x:Name="ChkAutoGameDetectProfiles" Content="Trocar perfil automaticamente ao abrir o jogo"
                                      IsChecked="True" Checked="OnAutoDetectToggled" Unchecked="OnAutoDetectToggled"
                                      VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Editar no Equalizador →" Style="{StaticResource CrimsonButton}" Padding="14,7" Margin="0,0,8,0"
                                        Click="OnGoToEqualizerClick"/>
                                <Button x:Name="BtnDeleteProfile" Content="Excluir Perfil" Style="{StaticResource GamerButton}" Padding="12,7"
                                        Click="OnDeleteProfileClick"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- ============================================================ -->
                <!-- PAGE 3: TESTAR SOM NO FONE                                   -->
                <!-- ============================================================ -->
                <Grid x:Name="PageSoundTest" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,22">
                        <TextBlock Text="Testar Som no Fone" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Ouça cenários simulados de combate (ou um áudio .WAV seu) para sentir a diferença do equalizador imediatamente."
                                   FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" MaxWidth="760" HorizontalAlignment="Left">
                        <Border Background="{StaticResource CardBgGradient}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="22">
                            <StackPanel>
                                <TextBlock Text="ESCOLHA O CENÁRIO DE TESTE" FontSize="11" FontWeight="Bold"
                                           Foreground="#FF4762" Margin="0,0,0,10"/>

                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbSoundLabScenario" Grid.Column="0" Height="38" Margin="0,0,10,0"
                                              SelectionChanged="OnLabScenarioChanged">
                                        <ComboBoxItem Content="Passos + Tiros (Combate Tático)" Tag="TacticalCombatMix" IsSelected="True"/>
                                        <ComboBoxItem Content="Apenas Passos (Movendo Esquerda / Direita)" Tag="FootstepsOnly"/>
                                        <ComboBoxItem Content="Ruído de Calibração (Pink Noise)" Tag="PinkNoiseReference"/>
                                        <ComboBoxItem x:Name="CmbLabWavItem" Content="Meu Arquivo .WAV" Tag="WavFile"/>
                                    </ComboBox>
                                    <Button Grid.Column="1" Content="Abrir .WAV..." Height="38" Padding="14,0"
                                            Style="{StaticResource GamerButton}" Click="OnLoadWavClick"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Button x:Name="BtnToggleSoundLab" Content="▶ OUVIR TESTE NO FONE" Height="44" Padding="24,0"
                                            FontSize="13.5" Style="{StaticResource CrimsonButton}" Click="OnToggleSoundLabClick" Margin="0,0,12,0"/>
                                    <Button x:Name="BtnTestQuickBypass" Content="Comparar: Ligado / Desligado" Height="44" Padding="16,0"
                                            Style="{StaticResource GamerButton}" Click="OnQuickBypassButtonClick"/>
                                </StackPanel>

                                <TextBlock x:Name="TxtSoundTestHint"
                                           Text="Dica: deixe o teste tocando, clique em 'Equalizador' no menu à esquerda e mova os sliders de 2k e 4k (PASSOS) para ouvir na hora."
                                           FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============================================================ -->
                <!-- PAGE 4: SAÍDA DE ÁUDIO & CONFIGURAÇÕES                       -->
                <!-- ============================================================ -->
                <Grid x:Name="PageAudioOutput" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,22">
                        <TextBlock Text="Saída de Áudio" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Escolha em qual fone de ouvido o FootStep EQ vai atuar e configure preferências do aplicativo."
                                   FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="780" HorizontalAlignment="Left">

                            <!-- CARD 1: HEADSET SELECTION & ACTIVATION -->
                            <Border Background="{StaticResource CardBgGradient}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="FONE DE OUVIDO PRINCIPAL" FontSize="11" FontWeight="Bold"
                                               Foreground="#FF4762" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CmbRenderDevices" Grid.Column="0" Height="38" Margin="0,0,10,0"
                                                  SelectionChanged="OnAudioDeviceChanged"/>
                                        <Button Grid.Column="1" Content="↻ Atualizar Fones" Height="38" Padding="14,0"
                                                Style="{StaticResource GamerButton}" Click="OnRefreshDevicesClick"/>
                                    </Grid>

                                    <!-- Status Banner + Activate Button -->
                                    <Border x:Name="AudioStatusBanner" Background="#120C0F" BorderBrush="#381A24"
                                            BorderThickness="1" CornerRadius="9" Padding="16,14" Margin="0,0,0,14">
                                        <DockPanel>
                                            <Button x:Name="BtnActivateHeadset" DockPanel.Dock="Right" Content="ATIVAR NO FONE"
                                                    Height="38" Padding="20,0" Style="{StaticResource CrimsonButton}"
                                                    Click="OnActivateHeadsetClick" Margin="14,0,0,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtAudioPageStatusTitle" Text="Ainda não ativado neste fone"
                                                           FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <TextBlock x:Name="TxtAudioPageStatusDesc"
                                                           Text="Clique em 'ATIVAR NO FONE' para aplicar o equalizador em todos os seus jogos sem atraso."
                                                           FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="✓ Sem atraso no som" FontSize="11.5" Foreground="#C8B6BC" Margin="0,0,18,0"/>
                                        <TextBlock Text="✓ Zero programas extras" FontSize="11.5" Foreground="#C8B6BC" Margin="0,0,18,0"/>
                                        <TextBlock Text="✓ Reversível em 1 clique" FontSize="11.5" Foreground="#C8B6BC"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: GENERAL PREFERENCES & SHORTCUTS -->
                            <Border Background="{StaticResource CardBgGradient}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="PREFERÊNCIAS E ATALHOS" FontSize="11" FontWeight="Bold"
                                               Foreground="#FF4762" Margin="0,0,0,12"/>

                                    <CheckBox x:Name="ChkAutoGameDetect"
                                              Content="Trocar perfil automaticamente quando abrir um jogo (CS2, Valorant, Warzone, Apex, R6)"
                                              IsChecked="True" Checked="OnAutoDetectToggled" Unchecked="OnAutoDetectToggled"
                                              Margin="0,0,0,10"/>

                                    <CheckBox x:Name="ChkMinimizeTray"
                                              Content="Manter rodando em segundo plano (bandeja do Windows) ao fechar a janela"
                                              IsChecked="True" Checked="OnMinimizeTrayToggled" Unchecked="OnMinimizeTrayToggled"
                                              Margin="0,0,0,16"/>

                                    <Border Background="#0D090B" BorderBrush="#2A161D" BorderThickness="1" CornerRadius="8" Padding="14,10">
                                        <UniformGrid Columns="3">
                                            <StackPanel>
                                                <TextBlock Text="Ctrl + Alt + B" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="#FF4762"/>
                                                <TextBlock Text="Ligar / Desligar EQ" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Ctrl + Alt + N" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="#FF4762"/>
                                                <TextBlock Text="Modo Passos" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Ctrl + Alt + 1..4" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="#FF4762"/>
                                                <TextBlock Text="Perfis Rápidos" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: GITHUB UPDATES -->
                            <Border Background="{StaticResource CardBgGradient}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,16,0,0">
                                <DockPanel>
                                    <Button x:Name="BtnCheckUpdates" DockPanel.Dock="Right" Content="Verificar Atualizações"
                                            Height="36" Padding="16,0" Style="{StaticResource GamerButton}"
                                            Click="OnCheckUpdatesClick" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtAppVersion" Text="ATUALIZAÇÕES VIA GITHUB (v1.0.0)" FontSize="11"
                                                   FontWeight="Bold" Foreground="#FF4762"/>
                                        <TextBlock x:Name="TxtUpdateStatus" Text="Verifique novas versões diretamente do repositório FootStep-EQ no GitHub."
                                                   FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>
