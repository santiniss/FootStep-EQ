<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>FootStepEQ</AssemblyName>
    <RootNamespace>StrikeEQ</RootNamespace>
    <Version>1.0.2</Version>
    <Product>FootStep EQ — Equalizador Gamer</Product>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <EmbeddedResource Include="..\..\publish\FootStepEQ.Apo.dll" LogicalName="FootStepEQ.Apo.dll" Condition="Exists('..\..\publish\FootStepEQ.Apo.dll')" />
  </ItemGroup>

</Project>
